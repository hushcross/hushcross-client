{
  "name": "@hushcross/core",
  "version": "0.1.0",
  "private": true,
  "description": "HushCross vault keys, notes, commitments, proofs, stealth addresses, and recovery.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "main": "./dist/browser.js",
  "types": "./dist/browser.d.ts",
  "exports": {
    ".": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    }
  },
  "files": [
    "dist",
    "artifacts"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@scure/bip39": "2.4.0",
    "@zk-kit/lean-imt": "2.2.5",
    "poseidon-lite": "0.3.0",
    "viem": "2.57.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  }
}
